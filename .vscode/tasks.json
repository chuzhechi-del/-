{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "微信开发者工具：打开项目并编译",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& '${config:wechatDevTools.cliPath}' open --project '${workspaceFolder}'"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
