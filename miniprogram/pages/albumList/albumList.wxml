<view class="page">
  <view class="loading-tip" wx:if="{{loading}}">加载中…</view>
  <view class="list" wx:else>
    <view class="album-card" wx:for="{{albums}}" wx:key="_id" data-id="{{item._id}}" bind:tap="toDetail">
      <view class="date">{{item.dateLabel || item.date}}</view>
      <view class="count">{{item.photoFileIds ? item.photoFileIds.length : 0}} 张照片</view>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && albums.length === 0}}">暂无相册，点击下方按钮新建</view>
  <view class="fab" bind:tap="toNewAlbum">
    <text>+ 新建相册</text>
  </view>
</view>
