.page {
  min-height: 100vh;
  background: #0a1628;
  padding: 24rpx;
  box-sizing: border-box;
}
.date-bar {
  color: rgba(255,255,255,0.95);
  font-size: 32rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.15);
}
.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.photo-wrap {
  width: calc(50% - 8rpx);
  border-radius: 12rpx;
  overflow: hidden;
  background: rgba(255,255,255,0.05);
}
.photo {
  width: 100%;
  height: 320rpx;
  display: block;
}
.loading {
  color: rgba(255,255,255,0.6);
  text-align: center;
  padding: 80rpx 0;
}
