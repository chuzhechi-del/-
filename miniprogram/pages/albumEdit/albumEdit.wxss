.page {
  min-height: 100vh;
  background: #fff;
  padding-top: 0;
  padding: 32rpx 40rpx;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}
.nav-bar {
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.nav-back {
  display: flex;
  align-items: center;
  color: #333;
  font-size: 30rpx;
}
.nav-back-arrow {
  font-size: 40rpx;
  line-height: 1;
}
.nav-back-text {
  margin-left: 4rpx;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}
.nav-placeholder {
  width: 120rpx;
}
.section {
  margin-bottom: 48rpx;
}
.row-label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
.label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}
.hint {
  font-size: 24rpx;
  color: #999;
  margin-left: auto;
}
.add-image-section .add-box {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  background: #fafafa;
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-plus {
  font-size: 72rpx;
  color: #bbb;
  font-weight: 200;
  line-height: 1;
}
.thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}
.thumb-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}
.thumb-img {
  width: 100%;
  height: 100%;
}
.thumb-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 28rpx;
}
.input {
  height: 80rpx;
  font-size: 30rpx;
  color: #333;
  padding: 0 8rpx;
  border-bottom: 1rpx solid #eee;
}
.row-tap {
  padding: 20rpx 0;
}
.date-value {
  margin-left: auto;
  font-size: 28rpx;
  color: #666;
  margin-right: 12rpx;
}
.chevron {
  font-size: 36rpx;
  color: #999;
}
.confirm-btn {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 60rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #8b9dc3;
  color: #fff;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
}
.confirm-btn[disabled] {
  opacity: 0.7;
}
