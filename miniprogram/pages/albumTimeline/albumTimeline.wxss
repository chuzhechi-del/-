/* 与首页一致的背景与层级 */
.page {
  min-height: 100vh;
  background: #0a1628;
  position: relative;
  box-sizing: border-box;
}

.bg-image-wrap {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.bg-image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 左上角返回文字按钮（第三个页面） */
.back-text {
  position: fixed;
  left: 32rpx;
  top: 80rpx;
  z-index: 4;
  font-size: 30rpx;
  color: #555;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.8);
}

/* 白色半透明蒙版，让背景不那么清晰 */
.fog-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  background: rgba(255, 255, 255, 0.6);
  pointer-events: none;
}

/* 页面中间的时光轴竖线 */
.timeline-center-line {
  position: fixed;
  top: 80rpx;
  bottom: 80rpx;
  left: 50%;
  width: 4rpx;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.22);
  border-radius: 999rpx;
  z-index: 2;
}

/* 六个时间节点 + 左右两侧的照片卡片 */
.timeline-node {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  z-index: 3;
}

/* 自下而上依次分布在竖线上：2015 在最下方，待续在最上方（用百分比均匀铺满整条线） */
.timeline-node-2015 { top: 86%; }
.timeline-node-2016 { top: 72%; }
.timeline-node-2017 { top: 58%; }
.timeline-node-2018 { top: 44%; }
.timeline-node-2019 { top: 30%; }
.timeline-node-more { top: 16%; }

.timeline-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.35);
  transform: translate(-50%, -50%);
}

.timeline-photo {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-photo-left {
  right: 56rpx;
  transform: translateY(-50%);
}

.timeline-photo-right {
  left: 56rpx;
  transform: translateY(-50%);
}

.timeline-photo-box {
  width: 260rpx;
  height: 180rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.75);
  /* 内阴影：顶侧高光 + 底侧压暗；外阴影：近处投影 + 远处扩散，增强层次 */
  box-shadow:
    inset 0 2rpx 8rpx rgba(255, 255, 255, 0.7),
    inset 0 -4rpx 16rpx rgba(0, 0, 0, 0.12),
    0 6rpx 18rpx rgba(0, 0, 0, 0.14),
    0 16rpx 44rpx rgba(0, 0, 0, 0.22);
  margin-bottom: 12rpx;
}

/* 顶部“待续”节点里的“更新中...”白底图片效果 */
.timeline-photo-updating {
  display: flex;
  align-items: center;
  justify-content: center;
}

.timeline-photo-updating-text {
  font-size: 28rpx;
  color: #777;
  letter-spacing: 4rpx;
}

.timeline-photo-label {
  font-size: 28rpx;
  color: #444;
  letter-spacing: 2rpx;
}

.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 100;
  background: transparent;
}
.nav-inner {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.nav-back {
  display: flex;
  align-items: center;
  color: #A8D8EA;
  font-size: 30rpx;
}
.nav-back-arrow { font-size: 40rpx; line-height: 1; }
.nav-back-text { margin-left: 4rpx; }
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  color: #A8D8EA;
  letter-spacing: 2rpx;
}
.nav-placeholder { flex-shrink: 0; }
.nav-import {
  flex-shrink: 0;
  color: #A8D8EA;
  font-size: 28rpx;
  padding: 8rpx 16rpx;
}

.timeline-scroll {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  box-sizing: border-box;
  z-index: 1;
  padding-bottom: env(safe-area-inset-bottom);
}

.timeline-track {
  position: relative;
  padding: 32rpx 32rpx 80rpx;
  min-height: 200rpx;
}
.timeline-line {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 2rpx;
  margin-left: -1rpx;
  background: rgba(168, 216, 234, 0.6);
  z-index: 0;
}
.timeline-loading {
  text-align: center;
  color: #A8D8EA;
  font-size: 28rpx;
  padding: 60rpx 0;
}
.timeline-item {
  position: relative;
  z-index: 1;
  margin-bottom: 40rpx;
  min-height: 120rpx;
  box-sizing: border-box;
}
.timeline-item .timeline-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 260rpx;
  max-width: 48%;
}
.timeline-item-left .timeline-content { margin-right: 50%; padding-right: 20rpx; align-items: flex-end; }
.timeline-item-right .timeline-content { margin-left: 50%; padding-left: 20rpx; align-items: flex-start; }
.timeline-item .timeline-node-wrap {
  position: absolute;
  left: 50%;
  top: 48rpx;
  transform: translate(-50%, -50%);
  width: 32rpx;
  display: flex;
  justify-content: center;
  pointer-events: none;
}
.timeline-node {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(168, 216, 234, 0.9);
}
.timeline-bubble {
  color: #A8D8EA;
  font-size: 26rpx;
  margin-bottom: 12rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.timeline-item-left .timeline-bubble { text-align: right; }
.timeline-item-right .timeline-bubble { text-align: left; }
.timeline-card {
  width: 260rpx;
  min-height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: rgba(35, 48, 68, 0.88);
  border: 1rpx solid rgba(168, 216, 234, 0.25);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.card-date {
  color: #A8D8EA;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}
.card-plus {
  color: #A8D8EA;
  font-size: 72rpx;
  font-weight: 200;
  line-height: 1;
  margin-bottom: 8rpx;
}
.card-label {
  color: #A8D8EA;
  font-size: 28rpx;
}

.card-cover {
  width: 100%;
  height: 200rpx;
  display: block;
}
.card-cover-placeholder {
  background: rgba(168, 216, 234, 0.12);
  color: #A8D8EA;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.timeline-bottom-spacer { height: 80rpx; }
