<view class="page">
  <!-- 第三个页面：3.png 背景 + 中间时光轴竖线 -->
  <view class="bg-image-wrap">
    <image class="bg-image" src="cloud://timeabulm-5gi8yiop0ed0acf9.7469-timeabulm-5gi8yiop0ed0acf9-1406692582/3.png" mode="aspectFill" />
  </view>
  <view class="fog-overlay"></view>
  <view class="back-text" bindtap="onBackTap">‹ 返回</view>
  <view class="timeline-center-line"></view>

  <!-- 六个时间节点：沿竖线一左一右排列，自下而上 -->
  <!-- 最底部：2015级毕业照（左） -->
  <view class="timeline-node timeline-node-2015">
    <view class="timeline-dot"></view>
    <view class="timeline-photo timeline-photo-left" bindtap="onPhoto2015Tap">
      <image class="timeline-photo-box" mode="aspectFill"
        src="cloud://timeabulm-5gi8yiop0ed0acf9.7469-timeabulm-5gi8yiop0ed0acf9-1406692582/albums/2015级毕业照/年级合照1.jpg" />
      <text class="timeline-photo-label">2015级毕业照</text>
    </view>
  </view>

  <!-- 向上：2016级毕业照（右） -->
  <view class="timeline-node timeline-node-2016">
    <view class="timeline-dot"></view>
    <view class="timeline-photo timeline-photo-right" bindtap="onPhoto2016Tap">
      <image class="timeline-photo-box" mode="aspectFill"
        src="cloud://timeabulm-5gi8yiop0ed0acf9.7469-timeabulm-5gi8yiop0ed0acf9-1406692582/albums/2016级毕业照/2016级1班.jpg" />
      <text class="timeline-photo-label">2016级毕业照</text>
    </view>
  </view>

  <!-- 向上：2017级毕业照（左） -->
  <view class="timeline-node timeline-node-2017">
    <view class="timeline-dot"></view>
    <view class="timeline-photo timeline-photo-left" bindtap="onPhoto2017Tap">
      <image class="timeline-photo-box" mode="aspectFill"
        src="cloud://timeabulm-5gi8yiop0ed0acf9.7469-timeabulm-5gi8yiop0ed0acf9-1406692582/albums/2017级毕业照/1班.png" />
      <text class="timeline-photo-label">2017级毕业照</text>
    </view>
  </view>

  <!-- 向上：2018级毕业照（右） -->
  <view class="timeline-node timeline-node-2018">
    <view class="timeline-dot"></view>
    <view class="timeline-photo timeline-photo-right" bindtap="onPhoto2018Tap">
      <image class="timeline-photo-box" mode="aspectFill"
        src="cloud://timeabulm-5gi8yiop0ed0acf9.7469-timeabulm-5gi8yiop0ed0acf9-1406692582/albums/2018级毕业照/1班.jpg" />
      <text class="timeline-photo-label">2018级毕业照</text>
    </view>
  </view>

  <!-- 向上：2019级毕业照（左） -->
  <view class="timeline-node timeline-node-2019">
    <view class="timeline-dot"></view>
    <view class="timeline-photo timeline-photo-left" bindtap="onPhoto2019Tap">
      <image class="timeline-photo-box" mode="aspectFill"
        src="cloud://timeabulm-5gi8yiop0ed0acf9.7469-timeabulm-5gi8yiop0ed0acf9-1406692582/albums/2019级毕业照/1班.jpg" />
      <text class="timeline-photo-label">2019级毕业照</text>
    </view>
  </view>

  <!-- 顶部：待续（右） -->
  <view class="timeline-node timeline-node-more">
    <view class="timeline-dot"></view>
    <view class="timeline-photo timeline-photo-right">
      <view class="timeline-photo-box timeline-photo-updating">
        <text class="timeline-photo-updating-text">更新中...</text>
      </view>
      <text class="timeline-photo-label">待续</text>
    </view>
  </view>
</view>
